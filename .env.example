# Copy this file to .env for local development.
# On Render, set these as Environment Variables in the dashboard instead of uploading .env.

# MongoDB Atlas connection string (see README for how to get this)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/examplatform?retryWrites=true&w=majority

# Long random string used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Port the server listens on (Render sets this automatically — leave as-is)
PORT=5000

# The public URL of your deployed site, used to build exam links in emails
PUBLIC_BASE_URL=http://localhost:5000

# Mailjet (mailjet.com) transactional email — get these from your Mailjet
# account under Account Settings → API Key Management
MAILJET_API_KEY=your_mailjet_api_key
MAILJET_API_SECRET=your_mailjet_api_secret
# Must be an email address/domain you've verified as a sender in Mailjet
MAILJET_FROM_EMAIL=exams@yourdomain.com
MAILJET_FROM_NAME=Examiner Platform
